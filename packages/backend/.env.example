PORT=8080
NODE_ENV=development

# Postgres connection. Match credentials with the root .env (see docker-compose.yml).
DATABASE_URL="postgresql://clawster:change-me-to-a-strong-password@localhost:5432/clawster"

# JWT signing secret (≥32 chars). Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-secret"

# AES-256-GCM key for encrypting WhatsApp session creds at rest.
# MUST be exactly 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
# (placeholder fails validation on purpose — backend refuses to boot until set)
MASTER_KEY="REPLACE_ME_WITH_64_HEX_CHARS"

# Local media storage directory (defaults to <cwd>/data/media if unset).
# In production, mount a persistent volume at this path so uploads survive redeploys.
# MEDIA_ROOT=/data/media

# AI integration (optional — chatbot features disabled when unset)
# CHAT_BASE_URL=https://api.ilmu.ai/v1
# CHAT_API_KEY=sk-...
# CHAT_MODEL=nemo-super
